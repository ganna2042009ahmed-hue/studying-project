{
    "manifest_version": 3,
    "name": "Website Customizer",
    "version": "1.0",
    "description": "Customize the appearance of websites.",
    "permissions": ["activeTab"],
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}